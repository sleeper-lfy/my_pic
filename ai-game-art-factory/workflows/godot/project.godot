; Minimal B/C experimental sprite playback. Open with Godot 4.
config_version=5
[application]
config/name="AI Art Factory - Unapproved B/C Experiment"
run/main_scene="res://comparison.tscn"
[display]
window/size/viewport_width=1024
window/size/viewport_height=720
window/size/window_width_override=1024
window/size/window_height_override=720
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.91, 0.92, 0.89, 1)
textures/default_filters/use_nearest_mipmap_filter=false
